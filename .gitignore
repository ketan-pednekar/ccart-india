# ============================================================
# PYTHON CACHE & BUILD ARTIFACTS
# ============================================================
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ============================================================
# EDITOR / IDE
# ============================================================
.vscode/
.idea/

# ============================================================
# NOTEBOOK CHECKPOINTS
# ============================================================
.ipynb_checkpoints/
*.ipynb

# ============================================================
# CCART OUTPUTS (DO NOT PUSH)
# ============================================================
outputs/
synthetic_runs/
synthetic_runs_multi/
diagnostics/

# Heat module outputs (DO NOT PUSH)
ccart/Heat/outputs/
ccart/Heat/viz/

# Heat ingested Zarrs (DO NOT PUSH)
ccart/Heat/ingested/hist/
ccart/Heat/ingested/ssp370/
ccart/Heat/ingested/ssp585/

# Maps and generated visuals
*.png
*.jpg
*.jpeg
*.svg

# ============================================================
# LARGE GEOSPATIAL FILES (RASTERS + CLIMATE DATA)
# ============================================================
*.tif
*.tiff
*.nc
*.grib
*.grb
*.h5
*.vrt
*.aux.xml
*.zarr/

# ============================================================
# DATA FOLDER (IGNORE EVERYTHING HEAVY)
# ============================================================
data/**
!data/README.md

# Ignore large vector datasets inside data/
data/**/*.gpkg
data/**/*.shp
data/**/*.dbf
data/**/*.prj
data/**/*.shx
data/**/*.cpg
data/**/*.zip
data/**/*.geojson

# Allow small geojsons inside code folders (e.g., masks)
!ccart/**/*.geojson

# DEM masks (heavy)
ccart/data/DEM_mask/

# ============================================================
# ENVIRONMENTS
# ============================================================
venv/
.env/
.venv/

# ============================================================
# CACHE FOLDERS
# ============================================================
cache/

# ============================================================
# QGIS PROJECTS
# ============================================================
qgis_project/

# ============================================================
# OS JUNK
# ============================================================
.DS_Store
Thumbs.db

# Optional: logs and temp files
# *.log
# logs/
# *.csv

# ============================================================
# FLOOD MODULE (legacy config removed)
# ============================================================
ccart/flood/config/paths.yaml
ccart/flood/config/flood_params.yaml

