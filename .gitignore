# -------------------------
# Python cache
# -------------------------
__pycache__/
*.pyc
*.pyo
*.pyd

# -------------------------
# Build artifacts
# -------------------------
*.egg-info/
dist/
build/

# -------------------------
# VS Code
# -------------------------
.vscode/

# -------------------------
# Notebook checkpoints
# -------------------------
.ipynb_checkpoints/

# -------------------------
# Outputs (DO NOT PUSH)
# -------------------------
outputs/
synthetic_runs/
synthetic_runs_multi/
diagnostics/

# Maps and generated visuals
*.png
*.jpg
*.jpeg
*.svg

# -------------------------
# Large geospatial files
# -------------------------
*.tif
*.tiff
*.nc
*.grib
*.grb
*.h5
*.parquet

# -------------------------
# Data folder (ignore everything heavy)
# -------------------------
data/**
!data/README.md

# Ignore large vector datasets inside data/
data/**/*.gpkg
data/**/*.shp
data/**/*.dbf
data/**/*.prj
data/**/*.shx
data/**/*.cpg
data/**/*.zip
data/**/*.geojson   # ignore large geojsons in data/

# Allow small geojsons in code folders
!ccart/**/*.geojson

# -------------------------
# Environments
# -------------------------
venv/
__pycache__/

# -------------------------
# Cache folders (ignore everywhere)
# -------------------------
cache/

# -------------------------
# QGIS
# -------------------------
qgis_project/

# -------------------------
# OS junk
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
# Flood module (ignore entirely)
# -------------------------
flood/**

# -------------------------
# VRT and aux files
# -------------------------
*.vrt
*.aux.xml

